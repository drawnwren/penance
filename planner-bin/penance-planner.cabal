cabal-version: 3.8
name: penance-planner
version: 0.1.0.0
build-type: Simple
license: MIT

executable penance-planner
  main-is: Main.hs
  hs-source-dirs: src
  other-modules:
    Penance.Json
    Penance.Plan
    Penance.Graph.Component
    Penance.Graph.Module
    Penance.Graph.Package
    Penance.Graph.TH
    Penance.Graph.Backpack
    Penance.Emit.Drv
  build-depends:
    base >=4.18 && <5,
    directory,
    filepath
  default-language: Haskell2010
  ghc-options: -Wall

executable penance-architecture-bench
  main-is: ArchitectureBenchMain.hs
  hs-source-dirs: src
  other-modules:
    Penance.Json
  build-depends:
    base >=4.18 && <5,
    directory,
    filepath,
    process,
    time
  default-language: Haskell2010
  ghc-options: -Wall

executable penance-bench
  main-is: BenchMain.hs
  hs-source-dirs: src
  build-depends:
    base >=4.18 && <5,
    directory,
    filepath,
    process,
    time
  default-language: Haskell2010
  ghc-options: -Wall

executable penance-rebuild-bench
  main-is: RebuildBenchMain.hs
  hs-source-dirs: src
  other-modules:
    Penance.Json
  build-depends:
    base >=4.18 && <5,
    directory,
    filepath,
    process,
    time
  default-language: Haskell2010
  ghc-options: -Wall

executable penance-lock
  main-is: LockMain.hs
  hs-source-dirs: src
  other-modules:
    Penance.Json
  build-depends:
    base >=4.18 && <5,
    Cabal,
    bytestring,
    directory,
    filepath
  default-language: Haskell2010
  ghc-options: -Wall
