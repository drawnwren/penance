cabal-version: 3.8
name: c-sources
version: 0.1.0.0
build-type: Simple
license: MIT

library
  exposed-modules: ForeignAnswer
  hs-source-dirs: src
  build-depends: base >=4.20 && <5
  c-sources: cbits/foreign_answer.c
  include-dirs: cbits/include
  install-includes: foreign_answer.h
  cc-options:
    -DPENANCE_C_BIAS=0
    -UPENANCE_C_BIAS
    -DPENANCE_C_BIAS=1
  default-language: Haskell2010

executable c-sources
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base >=4.20 && <5,
    c-sources
  default-language: Haskell2010
