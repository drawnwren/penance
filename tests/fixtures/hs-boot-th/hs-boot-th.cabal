cabal-version: 3.0
name: hs-boot-th
version: 0.1.0.0
build-type: Simple

library
  exposed-modules:
    Cycle.A,
    Cycle.B,
    TH.Dep,
    TH.Base,
    TH.Sibling,
    TH.Splice
  hs-source-dirs: src
  build-depends:
    base >=4.20 && <5,
    template-haskell
  default-language: Haskell2010

executable hs-boot-th
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base >=4.20 && <5,
    hs-boot-th
  default-language: Haskell2010
